{
  "expo": {
    "name": "Nexus",
    "slug": "mira-browser",
    "scheme": "nexus",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F1E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexus.browser",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsArbitraryLoadsInWebContent": false
        }
      }
    },
    "android": {
      "package": "com.nexus.browser",
      "versionCode": 7,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#14120E",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client",
      "./plugins/with-webview-hardening",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E8",
          "image": "./assets/splash-light.png",
          "imageWidth": 136,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F0E0C",
            "image": "./assets/splash-dark.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class androidx.work.impl.** { *; }\n-keep class * extends androidx.work.ListenableWorker { <init>(...); }\n-keep class * extends androidx.work.Worker { <init>(...); }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-dontwarn androidx.work.impl.**\n-keep public class * extends android.appwidget.AppWidgetProvider { public <init>(); }\n-keep class com.reactnativeandroidwidget.** { *; }\n-dontwarn com.reactnativeandroidwidget.**"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Nexus",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/widget-fonts/InstrumentSerif-Regular.ttf",
            "./assets/widget-fonts/InstrumentSans-Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Nexus",
              "label": "Nexus — Today's page",
              "description": "Today's hand-picked page and your shortcuts.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen",
              "previewImage": "./assets/widget-preview/nexus.png"
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3076513882745753~6456059602",
          "iosAppId": "ca-app-pub-3076513882745753~6456059602",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Nexus asks for this only to show and measure the single home-screen ad. You can change your choice at any time in Settings."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "Nexus",
                  "bundleIdentifier": "com.nexus.browser.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nexus.browser"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ca5991b7-929a-464c-a97f-c8fea41ab90c"
      }
    },
    "owner": "krishkishore"
  }
}
