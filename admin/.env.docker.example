# Copy to admin/.env on the VPS, then run `docker compose up -d --build`.
# Never commit the filled-in file.

# The exact hostname in DNS. Cloudflare terminates TLS; Caddy serves HTTP internally.
ADMIN_DOMAIN=mira.nexusnation.in

# Long random values. Generate with `openssl rand -hex 32`.
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# MongoDB Atlas SRV string. URL-encode special characters in the password.
# The database user needs readWrite on MONGODB_DB.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nexusbrowser
MONGODB_COLLECTION=catalog

# Optional. Uncomment when the host cannot resolve the Atlas SRV record.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
