{
	# The admin API is not needed in this deployment.
	admin off
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Serve the public privacy policy as a static file so Play Console can reach it.
	handle /privacy.html {
		root * /usr/share/caddy/public
		file_server
	}

	# Serve app-ads.txt so AdMob crawler can verify the publisher
	handle /app-ads.txt {
		root * /usr/share/caddy/public
		file_server
	}

	# Forward the original Host header and the X-Forwarded-Host that instabox
	# sets (the public host the client used). The app's same-origin CSRF check
	# compares Origin against X-Forwarded-Host behind this reverse proxy.
	reverse_proxy admin:3000 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
	}

	log {
		output stdout
		format console
	}
}
