# Copy to admin/.env.local before running the admin locally.
# For the VPS/Docker deployment, use .env.docker.example instead.
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# MongoDB Atlas. Use the SRV connection string from Atlas and URL-encode special
# characters in the password. The database user needs readWrite on MONGODB_DB.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nexusbrowser
MONGODB_COLLECTION=catalog

# Optional. Use a public resolver when the local network blocks the SRV lookup
# that mongodb+srv:// needs. Comma-separated IPv4 or IPv6 addresses; leave unset
# on hosts whose DNS already resolves Atlas.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Local preview only. When MONGODB_URI is unset, this lets `next dev` use
# admin/.data/catalog-state.json. Production ignores it.
# NEXUS_DEV_FILE_STORE=1
